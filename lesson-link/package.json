{
  "name": "lesson-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "zod": "npm run openapi-zod-client",
    "eslint": "eslint \"src/**/*.{ts,tsx,js}\" --fix",
    "openapi-zod-client": "swagger2openapi ./swagger.yaml -o open-api.json && openapi-zod-client ./open-api.json -o src/generated/api.ts --export-schemas -a --with-docs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write ./src && biome check --write ./src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^7.16.2",
    "@mantine/dates": "^7.16.2",
    "@mantine/dropzone": "^7.16.2",
    "@mantine/form": "^7.16.2",
    "@mantine/hooks": "^7.16.2",
    "@mantine/modals": "^7.16.2",
    "@mantine/notifications": "^7.16.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@tabler/icons-react": "^3.35.0",
    "@zodios/react": "^10.4.5",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.13",
    "gsap": "^3.13.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-imask": "^7.6.1",
    "swr": "^2.2.5",
    "uuid": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@zodios/core": "^10.9.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.13",
    "eslint-plugin-unused-imports": "^4.1.4",
    "openapi-zod-client": "^1.18.2",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "sass": "^1.83.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
